# ================================================================
# KÖKTEN AKTAR — Ortam Değişkenleri Şablonu
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerlerle doldurun.
# Uygulama başlarken src/lib/env.mjs (Zod) bu değişkenleri doğrular;
# eksik/hatalı bir değer varsa build/dev sunucusu başlamaz.
#
# ÖNEMLİ: NEXT_PUBLIC_ ön ekli olmayan HİÇBİR değişken istemciye (browser)
# gönderilmez. Gizli anahtarları asla NEXT_PUBLIC_ ile başlatmayın.
# ================================================================

# ---- Uygulama ----
NEXT_PUBLIC_APP_URL=https://www.koktenaktar.com.tr
# NODE_ENV'i TANIMLAMAYIN: Next.js/Vercel kendisi ayarlar (dev → development,
# build/canlı → production). Vercel ortam değişkenlerine eklenirse yanlış
# değerle çakışır ("NODE_ENV was incorrectly set" uyarısı).

# ---- Supabase (Veritabanı + Auth + Storage) ----
# Proje ayarları > API sekmesinden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# service_role anahtarı SADECE sunucu tarafında kullanılır (RLS'i bypass eder).
# Asla NEXT_PUBLIC_ olarak tanımlamayın, asla client'a göndermeyin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Storage presigned upload URL'lerinin süresi (saniye)
SUPABASE_STORAGE_SIGNED_URL_TTL=120

# ---- VakıfBank Sanal POS ----
# VakıfBank Sanal POS — Güvenli Ortak Ödeme (aktif ödeme sağlayıcısı).
# Test (dokümandaki paylaşımlı sandbox): MerchantNumber=000000000007955, TerminalNumber=VP000123, Password=123Ab456
# Canlı bilgiler: https://sanalpos.vakifbank.com.tr → Üye İşyeri İşlemleri → Üye İşyeri Yetkileri / Terminal Listesi
VAKIFBANK_MERCHANT_NUMBER=000000000007955
VAKIFBANK_TERMINAL_NUMBER=VP000123
VAKIFBANK_PASSWORD=123Ab456
# Test: https://inbound.apigatewaytest.vakifbank.com.tr:8443  |  Canlı: https://inbound.apigateway.vakifbank.com.tr:8443
VAKIFBANK_API_BASE_URL=https://inbound.apigatewaytest.vakifbank.com.tr:8443
# İptal/iade (virtualPos) servisleri. Test: aynı sunucu  |  Canlı: https://apigw.vakifbank.com.tr:8443
VAKIFBANK_VPOS_BASE_URL=https://inbound.apigatewaytest.vakifbank.com.tr:8443
# Test: https://guvenliodeme-test.vakifbank.com.tr  |  Canlı: https://guvenliodeme.vakifbank.com.tr
VAKIFBANK_PAYMENT_PAGE_URL=https://guvenliodeme-test.vakifbank.com.tr

# ---- Rate Limiting (Upstash Redis - Vercel Edge uyumlu) ----
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Sentry (Hata İzleme / Observability) ----
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o000000.ingest.sentry.io/000000
SENTRY_ORG=kokten-aktar
SENTRY_PROJECT=kokten-aktar-web
# CI/CD'de source map yüklemek için (yalnızca build sunucusunda kullanılır)
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cron / Arka Plan İşleri (Vercel Cron) ----
# Vercel Cron isteklerinin gerçekten Vercel'den geldiğini doğrulamak için paylaşılan sır.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- KVKK / Yasal ----
KVKK_DATA_EXPORT_FROM_EMAIL=veri-talebi@koktenaktar.com.tr

# ---- Brevo (sipariş onay e-postası — transactional) ----
# Brevo → Settings → SMTP & API → API Keys → Generate. Yoksa e-posta sessizce atlanır.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Yeni sipariş bildirimi bu adrese gider (boşsa gönderen adresine).
ORDER_NOTIFY_EMAIL=zileaktar@gmail.com

# ---- Telegram yönetici bildirimleri (opsiyonel — boşsa bildirim gönderilmez) ----
# Telegram'da @BotFather → /newbot → verilen anahtar. GİZLİDİR, kimseyle paylaşmayın.
TELEGRAM_BOT_TOKEN=
# Bota bir mesaj attıktan sonra alınan sohbet kimliği (yalnızca rakam).
TELEGRAM_CHAT_ID=

# ---- PII Kriptografisi (uygulama katmanı — src/lib/crypto/pii.ts) ----
# Şimdilik opsiyonel; şifreli/hash'li bir veritabanı sütunu kullanılmaya başlanınca zorunlu olur.
# ASLA rotasyon yapmayın — eski hash'ler eşleşmez, eski şifreli veriler çözülemez.
# AES-256-GCM anahtarı (64 hex karakter):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=
# TCKN gibi yalnızca eşleştirme için hash'lenen alanların pepper'ı:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_HMAC_PEPPER=

# ---- Cloudflare Turnstile (Giriş/Kayıt CAPTCHA) ----
# Cloudflare panelinden > Turnstile > widget'ın "Site Key" değeri (herkese açık).
# "Secret Key" ise Supabase panelinde Authentication > Attack Protection altına girilir,
# buraya YAZILMAZ.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxx

# ---- Analytics / Reklam Ölçümü (opsiyonel — boşsa hiç yüklenmez) ----
# Google Analytics 4: analytics.google.com > Yönetici > Veri Akışları > Ölçüm Kimliği (G-XXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta (Facebook) Pixel: business.facebook.com > Etkinlik Yöneticisi > Pixel Kimliği
NEXT_PUBLIC_META_PIXEL_ID=
# Not: Çerez banner'ında "Tümünü Kabul Et" seçilmeden bu script'ler yüklenmez (KVKK).
